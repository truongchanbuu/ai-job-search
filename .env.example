# Required backend/Compose credentials: fill privately. No values belong in this file.
RADAR_DATABASE_URL=
RADAR_DB_PASSWORD=
RADAR_API_TOKEN=
RADAR_READ_ONLY_TOKEN=

# Primary Discord application. Allowlists use comma-separated snowflake IDs.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_DIGEST_CHANNEL_ID=

# A second independently configured application; enable it in private YAML/DB config.
DISCORD_SECONDARY_BOT_TOKEN=
DISCORD_SECONDARY_APPLICATION_ID=
DISCORD_SECONDARY_PUBLIC_KEY=
DISCORD_SECONDARY_ALLOWED_USER_IDS=
DISCORD_SECONDARY_ALLOWED_GUILD_IDS=
DISCORD_SECONDARY_CHANNEL_ID=

# Required for deferred interactions: 32 random bytes, hex encoded.
RADAR_INTERACTION_ENCRYPTION_KEY=

# Optional deployment variables: leave unset until configured.
# RADAR_API_URL=
# RADAR_BIND=
# RADAR_PUBLIC_URL=
# RADAR_ALLOW_INSECURE_HTTP=
# RADAR_CONFIG_DIR=
# RADAR_PROFILE_DIR=
# RADAR_TEST_DATABASE_URL=

# Radar-owned Upwork OAuth state. Use a private 0700 directory outside the build context.
RADAR_UPWORK_STATE_DIR=
RADAR_UPWORK_ENCRYPTION_KEY=
# Optional public-client registration or HTTPS Client ID Metadata Document URL.
RADAR_UPWORK_CLIENT_ID=
RADAR_UPWORK_CLIENT_METADATA_URL=
# Optional explicit live-test opt-in (also requires the live-upwork-tests Cargo feature).
# RADAR_TEST_UPWORK_LIVE=

RADAR_DATABASE_ACQUIRE_TIMEOUT_SECONDS=
RADAR_HTTP_TIMEOUT_SECONDS=
RADAR_OPENAI_API_KEY=
RADAR_DATABASE_MAX_CONNECTIONS=
RADAR_DATABASE_IDLE_TIMEOUT_SECONDS=
RADAR_DATABASE_MAX_LIFETIME_SECONDS=
